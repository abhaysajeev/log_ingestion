# ══════════════════════════════════════════════════════════════════════════════
# Log Ingestion Platform — Environment Configuration Template
# Copy this file to .env and fill in your values before running.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Root password for the MongoDB admin user — use a strong random string
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Projects ──────────────────────────────────────────────────────────────────
# Each project's ingest key and dashboard token live in config/projects.json,
# not here -- create entries with:
#   python3 scripts/add_project.py byky-qa "BYKY QA" --profile byky

# ── Retention: days a log is kept (0 = forever) ───────────────────────────────
LOG_RETENTION_DAYS=45

# ── Rate limit: logs per minute, per project ──────────────────────────────────
RATE_LIMIT_PER_PROJECT=60000

# ── Backpressure (max Redis queue depth before 429) ───────────────────────────
QUEUE_BACKPRESSURE_LIMIT=50000

# ── Admin Endpoint Protection ─────────────────────────────────────────────────
# Token for /admin/* endpoints
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# ── Where nginx listens (pick one line) ───────────────────────────────────────
# nginx owns the host's 80/443 and the Let's Encrypt certificate:
COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# ...or behind the host's own reverse proxy, on 127.0.0.1:LOGS_LOCAL_PORT:
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxied.yml
# LOGS_LOCAL_PORT=8095

# ── Backups: days of nightly mongodump archives kept in ./backups ──────────────
BACKUP_RETAIN_DAYS=7

# ── SMTP Email Alerts (optional — leave SMTP_HOST blank to disable) ───────────
# Sends an alert email when DLQ depth exceeds ALERT_DLQ_THRESHOLD
#
# Common SMTP hosts:
#   Office 365 : smtp.office365.com  port 587
#   Gmail      : smtp.gmail.com      port 587
#   Self-hosted: mail.yourcompany.com port 587
#
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
ALERT_EMAIL_TO=admin@yourcompany.com
ALERT_DLQ_THRESHOLD=10
